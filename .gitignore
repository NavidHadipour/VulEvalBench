# Credentials -- every spelling and casing the project has used, so a renamed
# key file can never be committed by accident. The wildcard is the real guard;
# the explicit names are kept for readability.
api-key*.txt
api-key.txt
api-key-llm.txt
api-key-LLM.txt
api-key-judgment.txt
api-key-judgement.txt

# Python
__pycache__/
*.pyc
.venv/
venv/

# Run artefacts.
#
# runs/ and logs/ are excluded because they are generated output, they grow
# without bound, and a run directory can contain code cloned from a third-party
# repository whose licence is not this project's to redistribute.
#
# To share a specific result, commit that one run deliberately:
#     git add -f runs/run_2026-08-10_18-40-58
runs/
logs/
ingested/
models/

# Legacy directories from the pre-run-store layout, superseded by runs/.
dataset/
results/

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Not part of the published project.
#
# Papers/   third-party PDFs; their licences are not this project's to
#           redistribute.
# expose/   the thesis exposé -- a personal document, kept out of the public
#           code repository.
# .vscode/  editor configuration specific to one machine.
Papers/
expose/
.vscode/
